+function checkContext(p: Patch): void {
+  for (const c of CONTEXT) {
+    const at = adr(c[1]), w = p.word(at);
+    if (c[0] === 'w') { if (w !== c[2] >>> 0) fail(`unexpected word at 0x${at.toString(16)} (${c[3]})`); }
