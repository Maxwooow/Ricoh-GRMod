+        const kind = KINDS[next() - 1];
+        const colour = next();
+        const width = next();
+        const dash = (v: number): FramingDash => (v ? 'dashed' : 'solid');
+        switch (kind) {
+          case 'line': { const axis = next() ? 'v' : 'h'; const at = next() | (next() << 8); elements.push({ kind, axis, at, box: next(), dash: dash(next()), colour, width }); break; }
