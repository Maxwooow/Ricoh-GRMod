@@ -95,6 +101,30 @@
 const FEATURE3_BATTERY = 4;
 /** Third feature byte: bit 3, custom grid lines (`grid.ts`); two bytes follow, the 3x3 and the 4x4 style's lines. */
 const FEATURE3_CUSTOM_GRID = 8;
