diff --git a/core/src/fw/gr4v120/aspect/movie4k.ts b/core/src/fw/gr4v120/aspect/movie4k.ts
new file mode 100644
--- /dev/null
+++ b/core/src/fw/gr4v120/aspect/movie4k.ts
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/**
+ * 4K movies (GR IV firmware 1.20 and 1.21): the movie menu's Frame Rate line becomes
+ * "Frame Rate / Resolution", a submenu with the camera's Frame Rate list (60p / 30p / 24p) and a
+ * new list, Resolution: FHD / 4K.
+ *
+ * What the firmware has. A complete 4K path, behind a switch that always answers no (0x538AD500:
+ * `mov r0, #0; bx lr`; one of its callers logs "[LVC] for Debug 4K Movie!"). Asked when the live
+ * view of a movie is set up:
+ *  - the sensor's drive mode (0x536568D4): 60p is mode 4 whatever the answer; 30p is mode 3, or 6
+ *    with the switch; 24p is mode 2, or 5 with it (a 4592 x 2584 read-out, 1.35x narrower than the
+ *    FHD picture);
+ *  - the size recorded (0x538B376C): FHD, or 3840 x 2160 at 30p and 24p with the switch;
+ *  - the buffers of the live view (0x53652DBC), at 30p.
+ * Camera tests 094 to 097 (hand-patched test firmware, the switch answering yes) on a GR IV 1.21.
+ *
+ * What is changed:
+ *  - the switch answers bit 1 of MOVIE_BYTE, a byte of the user settings that nothing in the
+ *    firmware uses (alignment padding before a word; the factory-defaults initialiser, run in an
+ *    emulator on all 30 default records of 1.20 and of 1.21, never writes 0x771..0x773). It is
+ *    kept with the settings and copied with the user modes; every camera has 0 there: FHD;
+ *  - the movie menu's item 12 (Frame Rate): its line shows "4K 30p" / "4K 24p" or the camera's
+ *    60p / 30p / 24p under the title "Frame Rate / Resolution", and opens a submenu record of two
+ *    lines (as Setup's End Screen in `shutdown.ts`): Frame Rate, which opens the camera's own list
+ *    under its own number, and Resolution, a list record made from Frame Rate's;
+ *  - the two settings cannot disagree: choosing 4K at 60p sets 30p (the camera's own setter);
+ *    choosing 60p sets FHD. The Frame Rate list sets the row under the cursor at once and, left
+ *    without OK, the row that was current again; only OK (the record's set function) clears the
+ *    bit, so passing over 60p does not lose 4K. The Resolution list has no such functions: its
+ *    row is set by OK. Wherever the bit is still set at 60p (the list left another way), it
+ *    counts as FHD: the camera's own code records 60p in FHD whatever the switch says, and the
+ *    menu shows it so.
+ *  - one answer for as long as a live view runs. The switch is asked again later (the size recorded
+ *    is set again by 0x5365B8E4, which the live view's sequences call), while the drive mode and
+ *    the buffers are those of the live view's start; a setting changed in between would give a 4K
+ *    recording from the FHD read-out or the other way round. So the setting is copied into a byte
+ *    of the sbrk arena (`battery.ts`) where the live view is started (the call of 0x538B376C at
+ *    0x5365BA0C, in 0x5365B9A8, before any of the other three questions), and the switch answers
+ *    that byte: zero from start-up until the first live view.
+ * After the resolution is changed the camera therefore takes it at the next start of the live
+ * view (the shooting mode changed, or the camera switched on).
+ *
+ * Going back to a firmware without this: the bit means nothing there.
+ */
+import { FirmwareError } from '../../types';
+import { assembleWords, branchWord } from './arm';
+import { LANGUAGES, Patch, expectWord, widenTextRows } from './build';
+import { LIST_CONTROLLER_ID, SUBMENU_CONTROLLER_ID, TOP_SET_TITLE, addListRecords, addSubmenuRecord, hookControllerFactory, installTexts, listTable, readTexts, submenuTemplate } from './datestamp-menu';
+import { menuItemWords } from './menuwide';
+import { adr } from '../target';
+
+/** Byte 0x771 of the user settings (0x775 of the settings object): bit 0 the movie shake reduction by sensor shift (`moviesr.ts`), bit 1 4K. */
+export const MOVIE_BYTE = adr(0x550832a8) + 4 + 0x771;
+export const MOVIE_BYTE_OFFSET = 0x775;
+export const MOVIE_SENSOR_SR_BIT = 1;
+export const MOVIE_4K_BIT = 2;
+export const MOVIE4K_TEXT_IDS = { title: 1044, resolution: 1045, fhd: 1046, uhd: 1047, uhd30: 1048, uhd24: 1049 } as const;
+export const FRAME_RATE_MENU_ID = 0x020001e0;
+export const RESOLUTION_LIST_ID = 0x020001e1;
+
+const SWITCH = adr(0x538ad500); // the "debug 4K movie" switch
+const SWITCH_CALLS = [adr(0x53652dd8), adr(0x53656934), adr(0x53656a20), adr(0x538b3788)] as const;
+const MOVIE_SIZE = adr(0x538b376c); // (movie settings object): the size recorded, by the switch and the frame rate
+const START_SIZE_CALL = adr(0x5365ba0c); // bl MOVIE_SIZE where the live view is started (0x5365B9A8)
+/** "4K in this live view": the byte after the movie shake reduction's (`moviesr.ts`, 0x55839044) in the sbrk arena, zero at start-up. */
+export const MOVIE4K_LATCH = adr(0x55839044) + 1;
+const SETTINGS = adr(0x550832a8);
+const FRAME_RATE = 0x772; // the Frame Rate setting: 0 60p, 1 30p, 2 24p
+const FRAME_RATE_SET = adr(0x53332cb0); // (settings, value)
+const APP = adr(0x532406a4);
+const RESOURCES = adr(0x53240f98);
+const GET_SETTINGS = adr(0x53240c38);
+const FRAME_RATE_TEXT = adr(0x5338f348); // (resources + 4, frame rate) -> text 301..303
+const LINE_VALUE_TEXT = adr(0x5359d740); // (menu line, text)
+const SUBMENU_LINE_TEXT = adr(0x535a64b4); // (submenu line, text)
+const LIST_TEXT_ROW = adr(0x5359e0ac); // (list item, text)
+const LIST_AFTER_SET = adr(0x531daa64);
+const MOVIE_MENU = adr(0x53dc7bd0);
+const MOVIE_ITEM = 12;
+const FRAME_RATE_LIST_ID = 0x020000a0;
+const FRAME_RATE_LINE_DRAW = adr(0x531b2a0c);
+const FRAME_RATE_TITLE = 299;
+/** Frame Rate's list record (57 of the list table) and its handlers. */
+const FRAME_RATE_RECORD = 57;
+const LIST_RECORD = 0x4c;
+const FR_COUNT = adr(0x531d0b24);
+const FR_DRAW = adr(0x531d2b80);
+const FR_SET = adr(0x531d4d08);
+const FR_CURRENT = adr(0x531d66ec);
+const FR_SET_CLOSE = adr(0x531dc390); // +0x34: set, then LIST_AFTER_SET
+const FR_SET_KEPT = adr(0x531d4d38); // +0x3c: set with the row kept at +0x1a6
+
+/** "Resolution", in `LANGS` order (cs da en fi fr de el hu it ja ko nl pl pt ru zh-CN es sv th zh-TW tr). */
+export const RESOLUTION_NAMES: readonly string[] = [
+  'Rozlišení', 'Opløsning', 'Resolution', 'Tarkkuus', 'Résolution', 'Auflösung', 'Ανάλυση', 'Felbontás',
+  'Risoluzione', '解像度', '해상도', 'Resolutie', 'Rozdzielczość', 'Resolução', 'Разрешение', '分辨率',
+  'Resolución', 'Upplösning', 'ความละเอียด', '解析度', 'Çözünürlük',
+];
+
+function fail(code: string, message: string): never {
+  throw new FirmwareError(code, message);
+}
+const lo = (v: number): number => v & 0xffff;
+const hi = (v: number): number => v >>> 16;
+const BYTE = `movw r3, #${lo(MOVIE_BYTE)}; movt r3, #${hi(MOVIE_BYTE)}`;
+const RATE = `movw r2, #${lo(SETTINGS + FRAME_RATE)}; movt r2, #${hi(SETTINGS + FRAME_RATE)}; ldrb r2, [r2]`;
+
+/** The texts (before the menus use them): the title is the camera's own "Frame Rate" of each language, " / " and "Resolution". */
+export function movie4kTitles(patch: Patch): string[] {
+  return readTexts(patch, FRAME_RATE_TITLE).map((rate, k) => `${rate} / ${RESOLUTION_NAMES[k]}`);
+}
+
+/**
+ * The switch, the texts, the menu line, its submenu and the Resolution list. After every other
+ * addition that copies the submenu or the list table (it adds records the same way), and after the
+ * menus are made wide when they are (`menuItemWords` then names the copy the camera reads).
+ */
+export function installMovie4k(patch: Patch): void {
+  if (RESOLUTION_NAMES.length !== LANGUAGES) fail('internal', '4K movies: texts');
+  // --- The switch and its four callers.
+  expectWord(patch, SWITCH, 0xe3a00000); // mov r0, #0
+  expectWord(patch, SWITCH + 4, 0xe12fff1e); // bx lr
+  for (const call of SWITCH_CALLS) expectWord(patch, call, branchWord(call, SWITCH, 14, true));
+  expectWord(patch, MOVIE_SIZE, 0xe1a0c00d);
+  expectWord(patch, START_SIZE_CALL - 4, 0xe5c65740); // strb r5, [r6, #0x740]
+  expectWord(patch, START_SIZE_CALL, branchWord(START_SIZE_CALL, MOVIE_SIZE, 14, true));
+  expectWord(patch, START_SIZE_CALL + 4, 0xe3580001); // cmp r8, #1
+  // --- The Frame Rate setting and its line.
+  expectWord(patch, FRAME_RATE_SET, 0xe1a0c00d);
+  expectWord(patch, FRAME_RATE_LINE_DRAW, 0xe1a0c00d);
+  expectWord(patch, FRAME_RATE_LINE_DRAW + 0x30, branchWord(FRAME_RATE_LINE_DRAW + 0x30, FRAME_RATE_TEXT, 14, true));
+  expectWord(patch, FRAME_RATE_LINE_DRAW + 0x3c, branchWord(FRAME_RATE_LINE_DRAW + 0x3c, LINE_VALUE_TEXT, 14, true));
+  expectWord(patch, FRAME_RATE_LINE_DRAW + 0x44, 0xe300112b); // movw r1, #299
+  expectWord(patch, FRAME_RATE_LINE_DRAW + 0x50, branchWord(FRAME_RATE_LINE_DRAW + 0x50, TOP_SET_TITLE));
+  expectWord(patch, FRAME_RATE_TEXT, 0xe3510000); // cmp r1, #0
+  expectWord(patch, FRAME_RATE_TEXT + 8, 0xe300012d); // movw r0, #301 ("60p")
+  // --- Frame Rate's list record: text rows, the set function reached three ways.
+  const table = listTable(patch);
+  const official = patch.read(table + FRAME_RATE_RECORD * LIST_RECORD, LIST_RECORD);
+  const ov = new DataView(official.buffer);
+  if (ov.getUint32(0, true) !== 0x00010200 || ov.getUint32(4, true) !== 0 || ov.getUint32(0x0c, true) !== FR_COUNT || ov.getUint32(0x14, true) !== FR_DRAW || ov.getUint32(0x24, true) !== FR_SET
+    || ov.getUint32(0x2c, true) !== FR_CURRENT || ov.getUint32(0x34, true) !== FR_SET_CLOSE || ov.getUint32(0x3c, true) !== FR_SET_KEPT || [0x10, 0x18, 0x1c, 0x20, 0x28, 0x30, 0x38, 0x40, 0x44, 0x48].some((off) => ov.getUint32(off, true) !== 0)) {
+    fail('unexpected-layout', 'Frame Rate list record is not as expected');
+  }
+  expectWord(patch, FR_DRAW + 0x40, branchWord(FR_DRAW + 0x40, LIST_TEXT_ROW));
+  expectWord(patch, FR_SET, 0xe1a0c00d);
+  expectWord(patch, FR_SET + 4, 0xe92dd818); // push {r3, r4, fp, ip, lr, pc}
+  expectWord(patch, FR_SET + 0x2c, branchWord(FR_SET + 0x2c, FRAME_RATE_SET));
+  expectWord(patch, FR_SET_CLOSE + 0x10, branchWord(FR_SET_CLOSE + 0x10, FR_SET, 14, true));
+  expectWord(patch, FR_SET_CLOSE + 0x20, branchWord(FR_SET_CLOSE + 0x20, LIST_AFTER_SET));
+  expectWord(patch, FR_SET_KEPT, 0xe5d011a6); // ldrb r1, [r0, #0x1a6]
+  expectWord(patch, FR_SET_KEPT + 4, branchWord(FR_SET_KEPT + 4, FR_SET));
+
+  // --- Texts.
+  const T = MOVIE4K_TEXT_IDS;
+  const same = (text: string): string[] => new Array<string>(LANGUAGES).fill(text);
+  widenTextRows(patch, T.uhd24);
+  installTexts(patch, [{ id: T.title, names: movie4kTitles(patch) }, { id: T.resolution, names: RESOLUTION_NAMES }, { id: T.fhd, names: same('FHD') }, { id: T.uhd, names: same('4K') },
+    { id: T.uhd30, names: same('4K 30p') }, { id: T.uhd24, names: same('4K 24p') }]);
+
+  // --- The switch: 4K chosen, as it was when this live view was started (the call there has only r0 for the function).
+  const latch = patch.append((at) => assembleWords(
+    `${BYTE}; ldrb r3, [r3]
+     ands r3, r3, #${MOVIE_4K_BIT}; movne r3, #1
+     movw ip, #${lo(MOVIE4K_LATCH)}; movt ip, #${hi(MOVIE4K_LATCH)}; strb r3, [ip]
+     b #${MOVIE_SIZE}`, at), 16);
+  patch.setWord(START_SIZE_CALL, branchWord(START_SIZE_CALL, latch, 14, true), '4K movies: the Resolution setting is taken when the live view is started');
+  const answer = patch.append((at) => assembleWords(
+    `movw r0, #${lo(MOVIE4K_LATCH)}; movt r0, #${hi(MOVIE4K_LATCH)}; ldrb r0, [r0]
+     and r0, r0, #1
+     bx lr`, at), 16);
+  patch.setWord(SWITCH, branchWord(SWITCH, answer), '4K movies: the switch answers the Resolution setting of this live view');
+
+  // --- 60p confirmed in the Frame Rate list (row 0): FHD. Only the record's own set function, which the list's OK calls:
+  // the row under the cursor is set while the list is open (+0x34) and the row that was current is set again when the list
+  // is left without OK (+0x3c), both by calling 0x531D4D08 directly, and neither must lose the Resolution.
+  const rate = patch.append((at) => assembleWords(
+    `cmp r1, #0; bne #${FR_SET}
+     ${BYTE}; ldrb ip, [r3]; bic ip, ip, #${MOVIE_4K_BIT}; strb ip, [r3]
+     b #${FR_SET}`, at), 16);
+
+  // --- The Resolution list: FHD, 4K (this = r0; draw: item = r1, row = r2; set, current: row = r1).
+  const count = patch.append((at) => assembleWords('mov r0, #2; bx lr', at), 16);
+  const draw = patch.append((at) => assembleWords(
+    `cmp r2, #1; bxhi lr
+     mov r0, r1
+     movweq r1, #${T.uhd}; movwne r1, #${T.fhd}
+     b #${LIST_TEXT_ROW}`, at), 16);
+  const set = patch.append((at) => assembleWords(
+    `cmp r1, #1; bxhi lr
+     ${BYTE}; ldrb ip, [r3]; bic ip, ip, #${MOVIE_4K_BIT}; orreq ip, ip, #${MOVIE_4K_BIT}; strb ip, [r3]
+     bxne lr
+     ${RATE}; cmp r2, #0; bxne lr
+     push {r4, lr}
+     bl #${APP}; bl #${GET_SETTINGS}
+     mov r1, #1
+     pop {r4, lr}
+     b #${FRAME_RATE_SET}`, at), 16);
+  // current: 4K only with the setting and a frame rate that has it (as the line and the submenu show it).
+  const current = patch.append((at) => assembleWords(
+    `${BYTE}; ldrb r3, [r3]; ${RATE}
+     tst r3, #${MOVIE_4K_BIT}; cmpne r2, #0
+     movne r3, #1; moveq r3, #0
+     cmp r3, r1; moveq r0, #1; movne r0, #0; bx lr`, at), 16);
+  // The record: Frame Rate's (rows of text), without its two functions that set a row before OK: the row is set by OK alone.
+  const record = official.slice();
+  const rv = new DataView(record.buffer);
+  rv.setUint32(0x0c, count, true);
+  rv.setUint32(0x14, draw, true);
+  rv.setUint32(0x24, set, true);
+  rv.setUint32(0x2c, current, true);
+  rv.setUint32(0x34, 0, true);
+  rv.setUint32(0x3c, 0, true);
+  addListRecords(patch, [{ id: RESOLUTION_LIST_ID, record }], '4K movies');
+  // Frame Rate's record, in the table the camera reads now.
+  const rateRecord = listTable(patch) + FRAME_RATE_RECORD * LIST_RECORD;
+  expectWord(patch, rateRecord + 0x24, FR_SET);
+  patch.setWord(rateRecord + 0x24, rate, '4K movies: 60p confirmed sets FHD');
+
+  // --- The submenu: Frame Rate (the camera's list, its value as the line showed it), Resolution.
+  const lineRate = patch.append((at) => assembleWords(
+    `push {r4, r5, r6, lr}
+     mov r4, r1
+     bl #${APP}; bl #${RESOURCES}
+     ${RATE}; mov r1, r2
+     add r0, r0, #4; bl #${FRAME_RATE_TEXT}
+     mov r1, r0; mov r0, r4
+     pop {r4, r5, r6, lr}
+     b #${SUBMENU_LINE_TEXT}`, at), 16);
+  const lineResolution = patch.append((at) => assembleWords(
+    `mov r0, r1
+     ${BYTE}; ldrb r3, [r3]; ${RATE}
+     tst r3, #${MOVIE_4K_BIT}; cmpne r2, #0
+     movwne r1, #${T.uhd}; movweq r1, #${T.fhd}
+     b #${SUBMENU_LINE_TEXT}`, at), 16);
+  const sub = submenuTemplate(patch);
+  {
+    const r = new DataView(sub.buffer);
+    r.setUint16(2, T.title, true);
+    r.setUint16(8, FRAME_RATE_TITLE, true);
+    r.setUint16(10, T.resolution, true);
+    r.setUint32(0x14, FRAME_RATE_LIST_ID, true);
+    r.setUint32(0x18, RESOLUTION_LIST_ID, true);
+    r.setUint32(0x3c, lineRate, true);
+    r.setUint32(0x40, 0, true);
+    r.setUint32(0x44, lineResolution, true);
+    r.setUint32(0x48, 0, true);
+  }
+  addSubmenuRecord(patch, FRAME_RATE_MENU_ID, sub, '4K movies');
+  hookControllerFactory(patch, `movw ip, #${lo(FRAME_RATE_MENU_ID)}; movt ip, #${hi(FRAME_RATE_MENU_ID)}
+     cmp r1, ip; bne list
+     movw r1, #${lo(SUBMENU_CONTROLLER_ID)}; movt r1, #${hi(SUBMENU_CONTROLLER_ID)}; b prior
+     list: add ip, ip, #${RESOLUTION_LIST_ID - FRAME_RATE_MENU_ID}; cmp r1, ip; bne prior
+     movw r1, #${lo(LIST_CONTROLLER_ID)}; movt r1, #${hi(LIST_CONTROLLER_ID)}`, '4K movies: the submenu and the Resolution list');
+
+  // --- The movie menu's line: the value (4K with the frame rate, or the frame rate), the title; it opens the submenu.
+  const line = patch.append((at) => assembleWords(
+    `push {r4, r5, r6, lr}
+     mov r4, r1
+     ${BYTE}; ldrb r3, [r3]; ${RATE}
+     tst r3, #${MOVIE_4K_BIT}; beq plain
+     cmp r2, #1; movweq r1, #${T.uhd30}; beq have
+     cmp r2, #2; movweq r1, #${T.uhd24}; beq have
+     plain: mov r5, r2
+     bl #${APP}; bl #${RESOURCES}
+     mov r1, r5; add r0, r0, #4; bl #${FRAME_RATE_TEXT}
+     mov r1, r0
+     have: mov r0, r4; bl #${LINE_VALUE_TEXT}
+     mov r0, r4; movw r1, #${T.title}
+     pop {r4, r5, r6, lr}
+     b #${TOP_SET_TITLE}`, at), 16);
+  for (const at of menuItemWords(patch, MOVIE_MENU, MOVIE_ITEM)) {
+    if (patch.word(at.id) !== FRAME_RATE_LIST_ID || patch.word(at.draw) !== FRAME_RATE_LINE_DRAW) fail('unexpected-layout', 'movie menu > Frame Rate line is not the official one');
+    patch.setWord(at.draw, line, '4K movies: Frame Rate / Resolution, line of a submenu');
+    patch.setWord(at.id, FRAME_RATE_MENU_ID, '4K movies: Frame Rate / Resolution opens the submenu');
+  }
+}
diff --git a/core/src/fw/gr4v120/aspect/movieexp.ts b/core/src/fw/gr4v120/aspect/movieexp.ts
new file mode 100644
--- /dev/null
+++ b/core/src/fw/gr4v120/aspect/movieexp.ts
@@ -0,0 +1,246 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/**
+ * Exposure modes for movies (build option `movieExposure`, off unless asked for; GR IV 1.20 and
+ * 1.21): movies are recorded in the exposure mode of the mode dial (P, Av, Tv, M, the user modes),
+ * with the ISO setting of the still mode, instead of always in P with ISO auto; the movie screen
+ * shows shutter speed, aperture and ISO, and the dials and the ISO button work as for stills.
+ * There is no camera menu: it is in the firmware or not. Camera tests 089 to 089d (GR IV 1.21);
+ * the emulator checks are tools/movieexp/check.py.
+ *
+ * What the camera does. The exposure mode handed to the auto exposure is worked out in one place,
+ * the update of the shooting mode at 0x532599DC (1.20 addresses), from the mode dial:
+ *
+ *   base mode      0x53258D1C  dial position -> 0 P, 1 Tv, 2 Av, 5 M, 7 Sn, the user mode's own
+ *   virtual mode   0x53258DF0  still: the base mode (M with ISO auto -> 4; Sn by its settings)
+ *                              movie (settings +0xB76 == 1): always 0, P        <-- (1)
+ *   auto flags     0x53258E7C  Tv / Av / ISO chosen by the camera, from the virtual mode; for
+ *                              P, Tv, Av and Sn the ISO is auto only when the ISO setting is
+ *                              AUTO (+0xC3F), a check that is skipped for movies            <-- (2)
+ *   exposure mode  0x53258F58  from the flags: 0 P, 1 Tv, 2 Av, 3..7 the same with a fixed ISO
+ *                              and the two M; M with the shutter speed at B / T: 9 bulb, 10 time
+ *                              (0 when +0xB74 is 1 or 2)                                      <-- (3)
+ *
+ * The auto exposure itself (the library behind AeLiveViewExposure) is not limited to P for movies:
+ * it has program lines of its own for a movie in Tv, Av, M with ISO auto and M (0x5368FBB8: the
+ * lines 0x11, 6, 0x0A and 0x0B when the record's movie flag is set), and several places that treat
+ * "movie and M" apart. Only the three places above keep a movie in P.
+ *
+ * The changes:
+ *  (1) the movie branch of the virtual mode is not taken: a movie gets the virtual mode a still
+ *      would get;
+ *  (2) the ISO setting is looked at for movies too;
+ *  (3) for a movie, the bulb / time modes are never chosen (M with the shutter speed at B or T
+ *      records in P): the value read from +0xB74 for that decision reads 1 for a movie. It is used
+ *      for nothing else.
+ * With the mode dial at P and the ISO at AUTO the exposure is as in the official firmware.
+ *
+ * The screen and the ISO button (test 089b; in 089 the mode icon followed the dial, but no value
+ * was shown and the ISO button did nothing):
+ *  (4) The shooting screen's items are a table: 47 items, each with an "exists" byte per still /
+ *      movie (0x53DC08E0, two rows of 0x30) and a position per layout (0x53DBF9BC, four layouts of
+ *      0x30 x/y pairs: still, movie, and the two for the 1280x720 output). Shutter speed (item
+ *      30), aperture (31) and ISO (32) do not exist for movies and have no position in the movie
+ *      layouts. They now exist there, at the still layouts' positions (the bottom line is the
+ *      same in both: mode icon, then these three, exposure compensation, battery). Their update
+ *      functions (0x5318C218, 0x5318C410, 0x5318C654) do not look at still / movie themselves.
+ *  (5) The ISO function of the buttons (0x53396344: sends command 0x47, the ISO setting) returns
+ *      without doing anything for a movie; that branch is not taken any more.
+ *
+ * The dials and the values (test 089c; in 089b the three items stayed empty, the dials did nothing
+ * and the ISO setting opened by the ISO button showed no value; the exposure did follow the mode
+ * and the values set for stills):
+ *  (6) What a dial does comes from 0x533F7844: the function set for the effective shooting mode,
+ *      and for a movie (as the auto exposure sees it, 0x5377CAB8) everything but exposure
+ *      compensation is made "nothing". That is not done any more: the three dial handlers
+ *      (CaptureReadySwitchFunctionModel, 0x53392BC8 and its two siblings) then send the same
+ *      commands as for a still (0x39..0x40: Tv, Av, ISO, exposure compensation up / down), which
+ *      the shooting-mode controller carries out without a look at still / movie.
+ *  (7) CaptureReadyModel's texts for the shutter speed (0x533A8270), the aperture (0x533A8688),
+ *      the ISO icon (0x533A88FC) and the ISO value (0x533A89E0) take a "movie" argument and give
+ *      an empty text (no icon) when it is set. The shooting screen's three items and the
+ *      exposure-setting view (0x531BF1F8, the ISO setting among it) now pass 0: seven places, the
+ *      argument loaded right before each call.
+ *
+ * Bulb from the dial (test 089d; 089c works: values shown, dials and ISO setting as for stills, and
+ * the camera itself keeps the shutter speed within the movie's range, 1/60 at 60p, in Tv):
+ *  (8) In M with a fixed ISO, one step slower than the slowest shutter speed is B (then T, B+T):
+ *      the shutter-speed step (0x5325A958) sets the bulb state when the dial goes slower at the
+ *      limit, unless the ISO is auto (0x53258B68). For a movie that limit is the movie's, so one
+ *      step past 1/60 went to B, which (3) records in P. For a movie the step now answers the
+ *      "ISO auto" question with yes: the shutter speed stops at the limit as in Tv. A B / T set
+ *      for stills before changing to movie is still recorded in P, and the dial leads out of it.
+ */
+import { FirmwareError } from '../../types';
+import { assembleWords, branchTarget, branchWord } from './arm';
+import { ICON_CATALOG, Patch, expectWord } from './build';
+import { adr } from '../target';
+
+/** `ldrb r0, [r0, #0xb76]; bx lr`: 0 still, 1 movie. */
+const STILL_MOVIE_GETTER = adr(0x5329b310);
+/** `ldrb r0, [r0, #0xb74]; bx lr`: 1 or 2 keeps M out of bulb / time. */
+const BULB_GATE_GETTER = adr(0x5329b300);
+/** (1) `bne <movie: P>` after `bl STILL_MOVIE_GETTER; cmp r0, #0` in the virtual mode. */
+const VIRTUAL_MODE_MOVIE = adr(0x53258e14);
+/** (2) `ldmne sp, {r4-r9, fp, sp, pc}` (movie: return) after `bl STILL_MOVIE_GETTER; cmp r0, #0` in the auto flags. */
+const ISO_SETTING_MOVIE = adr(0x53258f3c);
+/** (3) `bl BULB_GATE_GETTER` in the update of the shooting mode (r0 = the settings). */
+const BULB_GATE_SITE = adr(0x53259aec);
+
+/** (4) "exists" bytes of the shooting screen's items: row 0 still, row 1 movie, 0x30 bytes each. */
+const SCREEN_ITEMS = adr(0x53dc08e0);
+/** (4) positions: four layouts (still, movie, still 1280x720, movie 1280x720) of 0x30 (x, y) pairs of words. */
+const SCREEN_POSITIONS = adr(0x53dbf9bc);
+const ITEM_ROW = 0x30;
+const LAYOUT = 0x180;
+/** Shutter speed, aperture, ISO: x in the two still layouts; y is 440 (720x480) and 680 (1280x720). */
+const EXPOSURE_ITEMS = [{ item: 30, x: 40 }, { item: 31, x: 200 }, { item: 32, x: 330 }] as const;
+const LAYOUT_Y = [440, 440, 680, 680] as const;
+/** (5) `beq <return>` after `bl STILL_MOVIE_GETTER; cmp r0, #1` in the buttons' ISO function. */
+const ISO_BUTTON_MOVIE = adr(0x53396400);
+
+/** The auto exposure's "movie" (`bl` target of the places below). */
+const AE_IS_MOVIE = adr(0x5377cab8);
+/** (6) `bne <keep>` after `bl AE_IS_MOVIE; cmp r0, #1`; then `cmp r4, #3; movne r4, #0`. */
+const DIAL_FUNCTION_MOVIE = adr(0x533f7888);
+/** (7) The texts' functions, and the places that load their "movie" argument (r2): [place, the word there, the call's distance, the function]. */
+const TEXT_TV = adr(0x533a8270);
+const TEXT_AV = adr(0x533a8688);
+const ICON_ISO = adr(0x533a88fc);
+const TEXT_ISO = adr(0x533a89e0);
+const MOV_R2_R5 = 0xe1a02005;
+const MOV_R2_R0 = 0xe1a02000;
+const LDRB_R2_R3_980 = 0xe5d32980;
+const LDRB_R2_IP_980 = 0xe5dc2980;
+const MOVIE_ARGUMENTS: readonly { at: number; word: number; call: number; link: boolean; to: number; what: string }[] = [
+  { at: adr(0x533a841c), word: MOV_R2_R5, call: 0x0c, link: false, to: TEXT_TV, what: 'shutter speed text' },
+  { at: adr(0x5318c344), word: LDRB_R2_R3_980, call: 0x0c, link: true, to: TEXT_AV, what: 'aperture text, shooting screen' },
+  { at: adr(0x531bd80c), word: MOV_R2_R0, call: 0x10, link: true, to: TEXT_AV, what: 'aperture text, exposure setting' },
+  { at: adr(0x5318c514), word: LDRB_R2_R3_980, call: 0x04, link: true, to: ICON_ISO, what: 'ISO icon, shooting screen' },
+  { at: adr(0x533a89c8), word: MOV_R2_R0, call: 0x14, link: false, to: ICON_ISO, what: 'ISO icon, exposure setting' },
+  { at: adr(0x5318c57c), word: LDRB_R2_IP_980, call: 0x18, link: true, to: TEXT_ISO, what: 'ISO text, shooting screen' },
+  { at: adr(0x533a8b10), word: MOV_R2_R5, call: 0x08, link: true, to: TEXT_ISO, what: 'ISO text, exposure setting' },
+];
+const MOV_R2_0 = 0xe3a02000;
+/** (8) `bl ISO_AUTO_NOW` in the shutter-speed step (r5 = the settings, r0 = the controller); then `cmp r0, #0; bne <plain step>`. */
+const BULB_STEP_SITE = adr(0x5325aa78);
+const ISO_AUTO_NOW = adr(0x53258b68);
+const BULB_STATE_SETTER = adr(0x532b63f0);
+
+const NOP = 0xe1a00000;
+const BX_LR = 0xe12fff1e;
+const CMP_R0_0 = 0xe3500000;
+
+function fail(message: string): never {
+  throw new FirmwareError('internal', `movie exposure: ${message}`);
+}
+
+export function installMovieExposure(patch: Patch): void {
+  expectWord(patch, STILL_MOVIE_GETTER, 0xe5d00b76);
+  expectWord(patch, STILL_MOVIE_GETTER + 4, BX_LR);
+  expectWord(patch, BULB_GATE_GETTER, 0xe5d00b74);
+  expectWord(patch, BULB_GATE_GETTER + 4, BX_LR);
+  // (1) mov r5, r0; bl getter; cmp r0, #0; bne movie
+  expectWord(patch, VIRTUAL_MODE_MOVIE - 8, branchWord(VIRTUAL_MODE_MOVIE - 8, STILL_MOVIE_GETTER, 14, true));
+  expectWord(patch, VIRTUAL_MODE_MOVIE - 4, CMP_R0_0);
+  expectWord(patch, VIRTUAL_MODE_MOVIE, 0x1a00000a);
+  expectWord(patch, VIRTUAL_MODE_MOVIE + 4, 0xe3540007); // cmp r4, #7: the still's path
+  // (2) mov r0, r8; bl getter; cmp r0, #0; ldmne (return)
+  expectWord(patch, ISO_SETTING_MOVIE - 8, branchWord(ISO_SETTING_MOVIE - 8, STILL_MOVIE_GETTER, 14, true));
+  expectWord(patch, ISO_SETTING_MOVIE - 4, CMP_R0_0);
+  expectWord(patch, ISO_SETTING_MOVIE, 0x189dabf0);
+  expectWord(patch, ISO_SETTING_MOVIE + 4, 0xe1a00008); // mov r0, r8: the still's path
+  // (3) mov r0, r5; bl getter; mov sb, r0
+  expectWord(patch, BULB_GATE_SITE - 4, 0xe1a00005);
+  expectWord(patch, BULB_GATE_SITE, branchWord(BULB_GATE_SITE, BULB_GATE_GETTER, 14, true));
+  expectWord(patch, BULB_GATE_SITE + 4, 0xe1a09000);
+
+  // As the getter (r0 = the settings; returns in r0), r1 also changes: the caller sets r1 anew
+  // before it is read (mov r1, r6 at +0x20), as after any call.
+  const gate = patch.append((at) => assembleWords(
+    `ldrb r1, [r0, #0xb76]
+     ldrb r0, [r0, #0xb74]
+     cmp r1, #1
+     moveq r0, #1
+     bx lr`, at), 4);
+  if (gate % 4 !== 0) fail('unaligned code');
+  patch.setWord(VIRTUAL_MODE_MOVIE, NOP, 'movie exposure: virtual shooting mode as for a still');
+  patch.setWord(ISO_SETTING_MOVIE, NOP, 'movie exposure: the ISO setting also for movies');
+  patch.setWord(BULB_GATE_SITE, branchWord(BULB_GATE_SITE, gate, 14, true), 'movie exposure: no bulb / time for a movie');
+
+  // (4) The items: rows as in the official tables (still: all three exist; movie: none of them,
+  // exposure compensation (33) and the battery (34) do), positions only in the still layouts.
+  const movieRow = SCREEN_ITEMS + ITEM_ROW;
+  expectWord(patch, SCREEN_ITEMS + 28, 0x01010101);
+  expectWord(patch, SCREEN_ITEMS + 32, 0x01010101);
+  expectWord(patch, movieRow + 28, 0x00000000);
+  expectWord(patch, movieRow + 32, 0x00010100);
+  for (const { item, x } of EXPOSURE_ITEMS) {
+    for (const layout of [0, 1, 2, 3]) {
+      const at = SCREEN_POSITIONS + layout * LAYOUT + item * 8;
+      const still = layout % 2 === 0;
+      expectWord(patch, at, still ? x : 0);
+      expectWord(patch, at + 4, still ? LAYOUT_Y[layout] : 0);
+    }
+  }
+  patch.setWord(movieRow + 28, 0x01010000, 'movie exposure: shutter speed and aperture on the movie screen');
+  patch.setWord(movieRow + 32, 0x00010101, 'movie exposure: ISO on the movie screen');
+  for (const { item, x } of EXPOSURE_ITEMS) {
+    for (const layout of [1, 3]) {
+      const at = SCREEN_POSITIONS + layout * LAYOUT + item * 8;
+      patch.setWord(at, x, 'movie exposure: position on the movie screen');
+      patch.setWord(at + 4, LAYOUT_Y[layout], 'movie exposure: position on the movie screen');
+    }
+  }
+
+  // (5) bl getter; cmp r0, #1; beq return; ...; mov r1, #0x47
+  expectWord(patch, ISO_BUTTON_MOVIE - 8, branchWord(ISO_BUTTON_MOVIE - 8, STILL_MOVIE_GETTER, 14, true));
+  expectWord(patch, ISO_BUTTON_MOVIE - 4, 0xe3500001);
+  expectWord(patch, ISO_BUTTON_MOVIE, 0x0affffdf);
+  expectWord(patch, ISO_BUTTON_MOVIE + 0x14, 0xe3a01047);
+  patch.setWord(ISO_BUTTON_MOVIE, NOP, 'movie exposure: the ISO button also for movies');
+
+  // (6) bl AE_IS_MOVIE; cmp r0, #1; bne keep; cmp r4, #3; movne r4, #0; keep: mov r0, r4
+  expectWord(patch, DIAL_FUNCTION_MOVIE - 8, branchWord(DIAL_FUNCTION_MOVIE - 8, AE_IS_MOVIE, 14, true));
+  expectWord(patch, DIAL_FUNCTION_MOVIE - 4, 0xe3500001);
+  expectWord(patch, DIAL_FUNCTION_MOVIE, 0x1a000001);
+  expectWord(patch, DIAL_FUNCTION_MOVIE + 4, 0xe3540003);
+  expectWord(patch, DIAL_FUNCTION_MOVIE + 8, 0x13a04000);
+  expectWord(patch, DIAL_FUNCTION_MOVIE + 12, 0xe1a00004);
+  patch.setWord(DIAL_FUNCTION_MOVIE, branchWord(DIAL_FUNCTION_MOVIE, DIAL_FUNCTION_MOVIE + 12), 'movie exposure: the dials as for a still');
+
+  // (7) The functions begin with the test of the argument (r2; the shutter speed's has it in r5 by then).
+  expectWord(patch, TEXT_TV + 0x40, 0xe3550000); // cmp r5, #0 (mov r5, r2 at +0x20)
+  expectWord(patch, TEXT_TV + 0x20, 0xe1a05002);
+  expectWord(patch, TEXT_AV, 0xe3520000); // cmp r2, #0
+  expectWord(patch, ICON_ISO + 8, 0xe1a04002); // mov r4, r2
+  expectWord(patch, ICON_ISO + 0x1c, 0xe3540000); // cmp r4, #0
+  expectWord(patch, TEXT_ISO + 4, 0xe3520000); // cmp r2, #0
+  for (const { at, word, call, link, to } of MOVIE_ARGUMENTS) {
+    expectWord(patch, at, word);
+    // The call itself, or an earlier addition's code in its place that goes on to the function (Sensor Shift's, at the
+    // shooting screen's ISO icon: `shift.ts`): a branch of the same kind into the appended area.
+    const w = patch.word(at + call);
+    if (!(w >>> 24 === (link ? 0xeb : 0xea) && branchTarget(at + call, w) >= ICON_CATALOG - 0x40)) expectWord(patch, at + call, branchWord(at + call, to, 14, link));
+  }
+  for (const { at, what } of MOVIE_ARGUMENTS) patch.setWord(at, MOV_R2_0, `movie exposure: ${what}`);
+
+  // (8) mov r0, r7; bl ISO_AUTO_NOW; cmp r0, #0; bne plain; mov r0, r5; mov r1, #1; bl BULB_STATE_SETTER
+  expectWord(patch, BULB_STEP_SITE - 4, 0xe1a00007);
+  expectWord(patch, BULB_STEP_SITE, branchWord(BULB_STEP_SITE, ISO_AUTO_NOW, 14, true));
+  expectWord(patch, BULB_STEP_SITE + 4, 0xe3500000);
+  expectWord(patch, BULB_STEP_SITE + 8, 0x1affffc7);
+  expectWord(patch, BULB_STEP_SITE + 12, 0xe1a00005);
+  expectWord(patch, BULB_STEP_SITE + 16, 0xe3a01001);
+  expectWord(patch, BULB_STEP_SITE + 20, branchWord(BULB_STEP_SITE + 20, BULB_STATE_SETTER, 14, true));
+  // r5 is the step's own copy of the settings (mov r5, r0 after the getter, kept to its end); r1 is set anew after the call.
+  const noBulb = patch.append((at) => [
+    ...assembleWords(
+      `ldrb r1, [r5, #0xb76]
+       cmp r1, #1
+       moveq r0, #1
+       bxeq lr`, at),
+    branchWord(at + 16, ISO_AUTO_NOW),
+  ], 4);
+  if (noBulb % 4 !== 0) fail('unaligned code');
+  patch.setWord(BULB_STEP_SITE, branchWord(BULB_STEP_SITE, noBulb, 14, true), 'movie exposure: the shutter speed stops at the movie limit in M');
+}
diff --git a/core/src/fw/gr4v120/aspect/moviesr.ts b/core/src/fw/gr4v120/aspect/moviesr.ts
new file mode 100644
--- /dev/null
+++ b/core/src/fw/gr4v120/aspect/moviesr.ts
@@ -0,0 +1,265 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/**
+ * Shake reduction for movies by sensor shift (GR IV firmware 1.20 and 1.21): the movie menu's
+ * Movie SR offers Off, Sensor Shift and Electronic instead of Off and On.
+ *
+ * What the firmware does. The shake reduction unit (a microcontroller of its own) moves the sensor
+ * when the main processor reports "shake reduction on" in the state it sends (field 0x13; built by
+ * 0x537BB254 from the still / movie mode and the two settings, sent again for the properties 0xF9,
+ * Shake Reduction, and 0x89, all settings). For a movie the firmware always reports off and, with
+ * Movie SR on, field 0x14: the unit's own movie parameters, for the electronic shake reduction that
+ * the main processor does by moving a window of the picture. For that window every movie is read
+ * with a margin of 5 % on each side (2064 x 1160, of which 1858 x 1044 are recorded as 1920 x 1080),
+ * also with Movie SR off: the flag is set for every movie live view by 0x5365C850 (when the live
+ * view is set up) and 0x5365AB38 (while it runs).
+ * Camera tests 090 to 093 (hand-patched test firmware) on a GR IV 1.21: with field 0x13 reported
+ * for a movie the unit stabilises as for stills, and without the margin the whole read-out is
+ * recorded.
+ *
+ * The setting. Movie SR itself (0x77B of the user settings; property 0xFA) stays what it is, the
+ * electronic shake reduction: 0 or 1, read by the camera's own code. "Sensor Shift" is bit 0 of
+ * MOVIE_BYTE (`movie4k.ts`), with Movie SR 0. So: Off = 0 / 0, Sensor Shift = 0 / bit, Electronic
+ * = 1 (the bit is cleared when it is chosen; Movie SR switched on another way, by an Fn button's
+ * Shake Reduction, counts as Electronic whatever the bit). A firmware without this sees Off or On.
+ *
+ * What is changed:
+ *  - Movie SR's list (record 62 of the list table): three rows, their set and "current";
+ *  - the icon of the setting on the menu line and on the shooting screen (the calls of the icon
+ *    function 0x53390E18 at 0x531B2C78 and 0x533A6AEC): the hand of the still shake reduction for
+ *    Sensor Shift, the hand with an "E" for Electronic;
+ *  - the state for the unit, a movie's field 0x13 (0x537BB2D8, `mov r2, #0`): on with Sensor
+ *    Shift, unless Sensor Shift's composition adjustment (`shift.ts`) holds the sensor;
+ *  - the state is sent again for property 0xFA too (0x536AF4DC), and at once when the list sets
+ *    the value;
+ *  - the margin: only with Electronic. As in test 093 it is decided when the live view is set up
+ *    (Movie SR as the camera side has it then) and kept for as long as that live view runs, in a
+ *    byte of the sbrk arena (`battery.ts`), so that window and margin cannot disagree: a change of
+ *    the setting moves the picture's edge at the next set-up (the shooting mode changed, or the
+ *    camera switched on).
+ * Off therefore records the whole read-out as well: about 11 % more of the scene than the
+ * official firmware's movies.
+ */
+import { FirmwareError } from '../../types';
+import { assembleWords, branchTarget, branchWord, movImmediate, movWord } from './arm';
+import { ICON_CATALOG, LANGUAGES, LOOKUP_BOUNDS, Patch, concat, expectWord, u16le, u32le, widenTextRows } from './build';
+import { LIST_SET_ITEM, TEXT_OFF, installTexts, listTable } from './datestamp-menu';
+import { MOVIE_BYTE, MOVIE_SENSOR_SR_BIT } from './movie4k';
+import type { ShiftCode } from './shift';
+import { adr } from '../target';
+
+export const MOVIESR_TEXT_IDS = { sensor: 1050, electronic: 1051 } as const;
+/** Identity 24 of the ratio icon numbers, never given out (as 734..739). */
+export const MOVIESR_ICON_ID = 740;
+/** "No margin in this live view": a byte of the sbrk arena (0x55839040..0x55839080, `battery.ts`), zero at start-up. */
+export const MOVIESR_LATCH = adr(0x55839044);
+
+const ICON_SR_OFF = 467;
+const ICON_SR_ON = 469;
+const SETTINGS = adr(0x550832a8);
+const MOVIE_SR_LIVE = 0x12c3; // Movie SR in effect (the setting kept is at 0x77f)
+const MOVIE_SR_SET = adr(0x533337ac); // (settings, value)
+const APP = adr(0x532406a4);
+const GET_SETTINGS = adr(0x53240c38);
+const ICON_OF = adr(0x53390e18); // (resources + 4, Movie SR, variant) -> icon 467 / 469
+const LINE_ICON_CALL = adr(0x531b2c78); // bl ICON_OF in the movie menu line's draw function (0x531B2C44)
+const SCREEN_ICON_TAIL = adr(0x533a6aec); // b ICON_OF: the shooting screen's icon, for a movie
+const SR_HOLDER = adr(0x550b9b20); // +4: SrMessage; its +0x60 the state
+const SR_STATE = adr(0x537bb254); // (state): build and send
+const SR_STATE_MOVIE = adr(0x537bb2d8); // mov r2, #0: field 0x13 for a movie
+const SR_PROPERTY = adr(0x536af4dc); // cmp r3, #0xf9 in the unit's property handler (0x536AF4BC)
+const MARGIN_SETUP = adr(0x5365c87c); // mov r3, #1 (then strb r3, [r5, #0x74c])
+const MARGIN_UPDATE = adr(0x5365ab70); // mov r3, #1 (then strb r3, [r6, #0x74c])
+const CAMERA_MOVIE_SR = adr(0x5377db4c); // (camera properties) -> Movie SR
+/** Movie SR's list record (62 of the list table) and its handlers. */
+const SR_RECORD = 62;
+const LIST_RECORD = 0x4c;
+const SR_TITLE = 415;
+const SR_COUNT = adr(0x531d0b4c);
+const SR_DRAW = adr(0x531d2c28);
+const SR_SET = adr(0x531d4e08);
+const SR_CURRENT = adr(0x531d67f0);
+
+/**
+ * In `LANGS` order (cs da en fi fr de el hu it ja ko nl pl pt ru zh-CN es sv th zh-TW tr). The two Chinese say "SR" as the
+ * camera's own texts do ("自动关闭SR"): the characters of 防抖 / 防震 are not in its texts of those languages.
+ * Where a language would use Sensor Shift's own name (`shift.ts`), the option says "mechanical" instead, so that the two
+ * are not taken for one thing (the comments here go on calling the option Sensor Shift).
+ */
+export const MOVIESR_SENSOR_NAMES: readonly string[] = [
+  'Mechanická', 'Mekanisk', 'Mechanical', 'Mekaaninen', 'Capteur', 'Sensor-Shift', 'Αισθητήρας', 'Érzékelő',
+  'Sensore', 'メカ式', '기계식', 'Mechanisch', 'Matryca', 'Sensor', 'Механическая', '传感器SR',
+  'Sensor', 'Mekanisk', 'เซ็นเซอร์', '感測器SR', 'Sensör',
+];
+export const MOVIESR_ELECTRONIC_NAMES: readonly string[] = [
+  'Elektronická', 'Elektronisk', 'Electronic', 'Elektroninen', 'Électronique', 'Elektronisch', 'Ηλεκτρονική', 'Elektronikus',
+  'Elettronica', '電子式', '전자식', 'Elektronisch', 'Elektroniczna', 'Eletrónica', 'Электронная', '电子SR',
+  'Electrónica', 'Elektronisk', 'อิเล็กทรอนิกส์', '電子SR', 'Elektronik',
+];
+
+function fail(code: string, message: string): never {
+  throw new FirmwareError(code, message);
+}
+const lo = (v: number): number => v & 0xffff;
+const hi = (v: number): number => v >>> 16;
+
+/** The icon of Electronic: the camera's shake reduction hand (40 x 40 RGBA) with an "E" at its lower right. */
+export function drawElectronicIcon(hand: Uint8Array): Uint8Array {
+  if (hand.length !== 40 * 40 * 4) fail('internal', 'movie shake reduction: icon size');
+  const px = hand.slice();
+  const E = ['######', '######', '##....', '#####.', '#####.', '##....', '##....', '######', '######'];
+  const X = 33, Y = 30;
+  const on = (x: number, y: number): boolean => y >= 0 && y < E.length && x >= 0 && x < 6 && E[y][x] === '#';
+  for (let y = -1; y <= E.length; y++) {
+    for (let x = -1; x <= 6; x++) {
+      let near = false;
+      for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) near = near || on(x + dx, y + dy);
+      if (!near || X + x > 39 || Y + y > 39) continue;
+      px.set(on(x, y) ? [255, 255, 255, 255] : [0, 0, 0, 255], ((Y + y) * 40 + X + x) * 4);
+    }
+  }
+  return px;
+}
+
+/** The texts and the icon (before the menus use them). Returns ICONBIN with the icon appended. */
+export function installMovieSrAssets(patch: Patch, iconbin: Uint8Array): Uint8Array {
+  if (MOVIESR_SENSOR_NAMES.length !== LANGUAGES || MOVIESR_ELECTRONIC_NAMES.length !== LANGUAGES) fail('internal', 'movie shake reduction: texts');
+  widenTextRows(patch, MOVIESR_TEXT_IDS.electronic);
+  installTexts(patch, [{ id: MOVIESR_TEXT_IDS.sensor, names: MOVIESR_SENSOR_NAMES }, { id: MOVIESR_TEXT_IDS.electronic, names: MOVIESR_ELECTRONIC_NAMES }]);
+  // The camera's icon: {u16 kind = 1, width, height, flags = 0, u32 offset in 4-byte units}.
+  const d = new DataView(patch.readMapped(patch.word(ICON_CATALOG + ICON_SR_ON * 4), 12).buffer);
+  if (d.getUint16(0, true) !== 1 || d.getUint16(2, true) !== 40 || d.getUint16(4, true) !== 40 || d.getUint16(6, true) !== 0) fail('unexpected-layout', 'shake reduction icon is not as expected');
+  const at = d.getUint32(8, true) * 4;
+  if (at + 6400 > iconbin.length) fail('unexpected-layout', 'shake reduction icon is not in ICONBIN');
+  if (patch.word(ICON_CATALOG + MOVIESR_ICON_ID * 4) !== 0) fail('unexpected-layout', 'icon number already in use');
+  const pad = (4 - (iconbin.length % 4)) % 4;
+  const offset = iconbin.length + pad;
+  const descriptor = patch.append(concat([u16le([1, 40, 40, 0]), u32le([offset / 4])]), 16);
+  patch.write(ICON_CATALOG + MOVIESR_ICON_ID * 4, u32le([descriptor]));
+  for (const [site, register] of LOOKUP_BOUNDS) {
+    if ((patch.word(site) & 0xfff0f000) >>> 0 !== (0xe3000000 | (register << 12)) >>> 0) fail('unexpected-layout', 'icon bound is not a MOVW');
+    patch.setWord(site, movWord(register, Math.max(MOVIESR_ICON_ID, movImmediate(patch.word(site)))), 'icon upper bound');
+  }
+  return concat([iconbin, new Uint8Array(pad), drawElectronicIcon(iconbin.slice(at, at + 6400))]);
+}
+
+/**
+ * The list, the icons, the state for the unit and the margin. `shift`: Sensor Shift's module when
+ * it is in the build (its composition adjustment holds the sensor: no shake reduction then).
+ * Before any addition that copies the list table is fine, and after: the record is changed where
+ * the table is.
+ */
+export function installMovieSr(patch: Patch, shift: ShiftCode | null): void {
+  const BYTE = `movw r3, #${lo(MOVIE_BYTE)}; movt r3, #${hi(MOVIE_BYTE)}`;
+  const LIVE = `movw ip, #${lo(SETTINGS + MOVIE_SR_LIVE)}; movt ip, #${hi(SETTINGS + MOVIE_SR_LIVE)}; ldrb ip, [ip]`;
+  // --- What this relies on.
+  expectWord(patch, ICON_OF, 0xe3510000); // cmp r1, #0
+  expectWord(patch, LINE_ICON_CALL, branchWord(LINE_ICON_CALL, ICON_OF, 14, true));
+  expectWord(patch, LINE_ICON_CALL - 8, 0xe3a02000); // mov r2, #0 (variant)
+  expectWord(patch, SCREEN_ICON_TAIL, branchWord(SCREEN_ICON_TAIL, ICON_OF));
+  expectWord(patch, MOVIE_SR_SET, 0xe1a0c00d);
+  expectWord(patch, SR_STATE, 0xe1a0c00d);
+  expectWord(patch, SR_STATE_MOVIE - 8, 0xe1a00004); // mov r0, r4
+  expectWord(patch, SR_STATE_MOVIE - 4, 0xe3a01013); // mov r1, #0x13
+  expectWord(patch, SR_STATE_MOVIE, 0xe3a02000); // mov r2, #0
+  expectWord(patch, SR_STATE_MOVIE + 8, 0xe3560000); // cmp r6, #0 (Movie SR: field 0x14)
+  expectWord(patch, SR_PROPERTY, 0xe35300f9); // cmp r3, #0xf9
+  expectWord(patch, SR_PROPERTY + 4, 0x0a000018); // beq: the state built and sent
+  expectWord(patch, SR_PROPERTY + 8, 0xe35300fb); // cmp r3, #0xfb
+  for (const [site, register] of [[MARGIN_SETUP, 5], [MARGIN_UPDATE, 6]] as const) {
+    expectWord(patch, site, 0xe3a03001); // mov r3, #1
+    expectWord(patch, site + 4, (0xe5c0374c | (register << 16)) >>> 0); // strb r3, [rX, #0x74c]
+  }
+  expectWord(patch, CAMERA_MOVIE_SR + 4, 0xe1a0c00d); // mov ip, sp
+  const record = listTable(patch) + SR_RECORD * LIST_RECORD;
+  const rv = new DataView(patch.read(record, LIST_RECORD).buffer);
+  if (rv.getUint32(0, true) !== 0x00010000 || rv.getUint16(4, true) !== SR_TITLE || rv.getUint32(0x0c, true) !== SR_COUNT || rv.getUint32(0x14, true) !== SR_DRAW || rv.getUint32(0x24, true) !== SR_SET
+    || rv.getUint32(0x2c, true) !== SR_CURRENT || [0x10, 0x18, 0x1c, 0x20, 0x28, 0x30, 0x34, 0x38, 0x3c, 0x40, 0x44, 0x48].some((off) => rv.getUint32(off, true) !== 0)) fail('unexpected-layout', 'Movie SR list record is not as expected');
+  expectWord(patch, SR_SET + 0x2c, branchWord(SR_SET + 0x2c, MOVIE_SR_SET));
+
+  // --- The list: Off, Sensor Shift, Electronic (this = r0; draw: item = r1, row = r2; set, current: row = r1).
+  const count = patch.append((at) => assembleWords('mov r0, #3; bx lr', at), 16);
+  const draw = patch.append((at) => assembleWords(
+    `cmp r2, #2; bxhi lr
+     mov r0, r1
+     movw r1, #${ICON_SR_OFF}; movw r3, #${TEXT_OFF}
+     cmp r2, #1
+     movweq r1, #${ICON_SR_ON}; movweq r3, #${MOVIESR_TEXT_IDS.sensor}
+     movwhi r1, #${MOVIESR_ICON_ID}; movwhi r3, #${MOVIESR_TEXT_IDS.electronic}
+     mov r2, r3
+     b #${LIST_SET_ITEM}`, at), 16);
+  // set: the bit, then Movie SR through the camera's own setter (its property goes to the camera side), then the state for the unit.
+  const set = patch.append((at) => assembleWords(
+    `cmp r1, #2; bxhi lr
+     push {r4, lr}
+     mov r4, r1
+     ${BYTE}; ldrb ip, [r3]; bic ip, ip, #${MOVIE_SENSOR_SR_BIT}
+     cmp r4, #1; orreq ip, ip, #${MOVIE_SENSOR_SR_BIT}
+     strb ip, [r3]
+     bl #${APP}; bl #${GET_SETTINGS}
+     cmp r4, #2; moveq r1, #1; movne r1, #0
+     bl #${MOVIE_SR_SET}
+     movw r0, #${lo(SR_HOLDER + 4)}; movt r0, #${hi(SR_HOLDER + 4)}; ldr r0, [r0]
+     cmp r0, #0; ldrne r0, [r0, #0x60]; cmpne r0, #0
+     pop {r4, lr}
+     bxeq lr
+     b #${SR_STATE}`, at), 16);
+  // current: 2 with Movie SR on, else 1 with the bit, else 0.
+  const MODE = `${LIVE}; cmp ip, #0; movne r0, #2; bne have
+     ${BYTE}; ldrb r0, [r3]; and r0, r0, #${MOVIE_SENSOR_SR_BIT}
+     have:`;
+  const current = patch.append((at) => assembleWords(
+    `${MODE} cmp r0, r1; moveq r0, #1; movne r0, #0; bx lr`, at), 16);
+  patch.setWord(record + 0x0c, count, 'movie shake reduction: three rows');
+  patch.setWord(record + 0x14, draw, 'movie shake reduction: Off, Sensor Shift, Electronic');
+  patch.setWord(record + 0x24, set, 'movie shake reduction: the row chosen');
+  patch.setWord(record + 0x2c, current, 'movie shake reduction: the row current');
+
+  // --- The icon of the setting: (resources + 4, Movie SR, variant).
+  const icon = patch.append((at) => assembleWords(
+    `cmp r2, #0; bne native
+     cmp r1, #0; movwne r0, #${MOVIESR_ICON_ID}; bxne lr
+     ${BYTE}; ldrb r3, [r3]; tst r3, #${MOVIE_SENSOR_SR_BIT}
+     movwne r0, #${ICON_SR_ON}; bxne lr
+     native: b #${ICON_OF}`, at), 16);
+  patch.setWord(LINE_ICON_CALL, branchWord(LINE_ICON_CALL, icon, 14, true), 'movie shake reduction: the menu line\'s icon');
+  patch.setWord(SCREEN_ICON_TAIL, branchWord(SCREEN_ICON_TAIL, icon), 'movie shake reduction: the shooting screen\'s icon');
+
+  // --- The state for the unit, a movie: field 0x13 = Sensor Shift chosen, Movie SR off, the sensor not held. r0, r1 kept.
+  // Movie SR as the function itself has it (r6, from the camera side, what field 0x14 is made of just after): the two
+  // fields then always belong to the same value, also while a change of the setting is still on its way to the camera side.
+  const held = shift ? `cmp r2, #0; bxeq lr
+     push {r0, r1, r2, r3, ip, lr}
+     mov r1, #4; ${shift.loadCtx}; bl #${shift.code}
+     cmp r0, #0
+     pop {r0, r1, r2, r3, ip, lr}
+     movne r2, #0` : '';
+  const state = patch.append((at) => assembleWords(
+    `${BYTE}; ldrb r2, [r3]; and r2, r2, #${MOVIE_SENSOR_SR_BIT}
+     cmp r6, #0; movne r2, #0
+     ${held}
+     bx lr`, at), 16);
+  patch.setWord(SR_STATE_MOVIE, branchWord(SR_STATE_MOVIE, state, 14, true), 'movie shake reduction: the sensor shift on for a movie');
+  // --- The state is sent again when Movie SR changes (property 0xFA), as for Shake Reduction (0xF9).
+  const again = branchTarget(SR_PROPERTY + 4, patch.word(SR_PROPERTY + 4));
+  const property = patch.append((at) => assembleWords(
+    `cmp r3, #0xf9; cmpne r3, #0xfa
+     beq #${again}
+     b #${SR_PROPERTY + 8}`, at), 16);
+  patch.setWord(SR_PROPERTY, branchWord(SR_PROPERTY, property), 'movie shake reduction: the state sent again when Movie SR changes');
+
+  // --- The margin: with Electronic only; decided when the live view is set up (r4 = the live view), kept while it runs.
+  const LATCH = `movw r3, #${lo(MOVIESR_LATCH)}; movt r3, #${hi(MOVIESR_LATCH)}`;
+  const setup = patch.append((at) => assembleWords(
+    `push {r0, r1, r2, r3, ip, lr}
+     ldr r0, [r4, #0x3bc]; bl #${CAMERA_MOVIE_SR}
+     cmp r0, #0; moveq r1, #1; movne r1, #0
+     ${LATCH}; strb r1, [r3]
+     eor r1, r1, #1; str r1, [sp, #0xc]
+     pop {r0, r1, r2, r3, ip, pc}`, at), 16);
+  const update = patch.append((at) => assembleWords(
+    `${LATCH}; ldrb r3, [r3]
+     eor r3, r3, #1
+     bx lr`, at), 16);
+  patch.setWord(MARGIN_SETUP, branchWord(MARGIN_SETUP, setup, 14, true), 'movie shake reduction: the margin with Electronic only');
+  patch.setWord(MARGIN_UPDATE, branchWord(MARGIN_UPDATE, update, 14, true), 'movie shake reduction: the margin as decided at set-up');
+}
diff --git a/core/src/fw/gr4v120/aspect/package.ts b/core/src/fw/gr4v120/aspect/package.ts
--- a/core/src/fw/gr4v120/aspect/package.ts
+++ b/core/src/fw/gr4v120/aspect/package.ts
@@ -22,11 +22,13 @@
  * (0.8.6) one more byte of additions, where earlier builds have their zero padding: bit 0, the HDR
  * gain map (`hdrgain.ts`); bit 1, ADJ lever slots (`adjslots.ts`), their number (6..8) follows in
